# ======================================
# BACKEND ENVIRONMENT VARIABLES  
# ======================================
# For Railway deployment, add these as Environment Variables in the Railway dashboard

# ======================================
# CRITICAL - MUST BE SET
# ======================================

# Database Connection (Railway provides this automatically)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# JWT Secret (GENERATE WITH: openssl rand -base64 64)
# Example strong secret:
# FqxXiW0Rv0eVcMZOSTx0T8TCLqF9mNtlW/5Gt4O/s44rHZ0Q7j3D9/vFM1+7PKa89ONFRKHvr0csoz09kmrROA==
JWT_SECRET=paste_your_generated_secret_here

# ======================================
# SERVER CONFIGURATION
# ======================================

PORT=3002
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# ======================================
# AWS S3 - REQUIRED for file uploads
# ======================================

AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-3
S3_BUCKET_NAME=roomy-ae

# ======================================
# OPTIONAL
# ======================================

JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

